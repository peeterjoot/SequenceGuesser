Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"alpha", ",", " ", "beta", ",", " ", "a", ",", "b"}], "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SetDirectory", "[", "\"\<~/tmp\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"data", "=", 
     RowBox[{"Import", "[", "\"\<data.json\>\"", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"ClearAll", "[", "plotOnePair", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plotOnePair", "[", 
     RowBox[{"element_", ",", " ", "onePlot_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "test", ",", "pred", ",", "alpha", ",", "beta", ",", "a", ",", "b", ",",
         " ", "defaultOptions", ",", " ", "onePlotOptions", ",", " ", 
        "manyPlotOptions"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"a", "=", 
        RowBox[{"Lookup", "[", 
         RowBox[{"element", ",", "\"\<a\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"b", "=", 
        RowBox[{"Lookup", "[", 
         RowBox[{"element", ",", "\"\<b\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"alpha", "=", 
        RowBox[{"Lookup", "[", 
         RowBox[{"element", ",", "\"\<alpha\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"beta", "=", 
        RowBox[{"Lookup", "[", 
         RowBox[{"element", ",", "\"\<beta\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"test", "=", 
        RowBox[{"Lookup", "[", 
         RowBox[{"element", ",", "\"\<test_sequence\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"pred", "=", 
        RowBox[{"Lookup", "[", 
         RowBox[{"element", ",", "\"\<predictions\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"defaultOptions", " ", "=", " ", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"PlotMarkers", "->", "Automatic"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"PlotStyle", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Blue", "//", " ", "Darker"}], ",", 
             RowBox[{"Red", "//", "Darker"}]}], "}"}]}]}], 
         "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"onePlotOptions", "=", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"PlotLegends", "->", " ", 
           RowBox[{"Placed", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"{", 
                
                RowBox[{"\"\<\\\\color{BlueDarker}\\\\mathrm{\\\\mbox{Test \
Sequence}}\>\"", 
                 ",", "\"\<\\\\color{RedDarker}\\\\mathrm{\\\\mbox{\
Predictions}}\>\""}], "}"}], " ", "//", " ", "MaTeX"}], ")"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"Left", ",", "Top"}], "}"}]}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"PlotLabel", "->", 
           RowBox[{"MaTeX", "[", 
            RowBox[{"StringForm", "[", 
             
             RowBox[{"\"\<\\\\alpha = ``, \\\\beta = ``, a = ``, b = ``\>\"", 
              ",", "alpha", ",", "beta", ",", "a", ",", "b"}], "]"}], 
            "]"}]}]}], "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{",", "\[IndentingNewLine]", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"\"\<Index\>\"", ",", "\"\<Value\>\""}], "}"}], "//", 
              "MaTeX"}], ")"}]}]}], "*)"}], "\[IndentingNewLine]", "}"}]}], ";",
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"manyPlotOptions", " ", "=", " ", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{"Ticks", " ", "->", " ", "None"}], "\[IndentingNewLine]", 
         "}"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"test", ",", "pred"}], "}"}], ",", 
         RowBox[{"Sequence", "@@", 
          RowBox[{"If", "[", 
           RowBox[{"onePlot", ",", 
            RowBox[{"Join", "[", 
             RowBox[{"defaultOptions", ",", " ", "onePlotOptions"}], "]"}], ",", 
            RowBox[{"Join", "[", 
             RowBox[{"defaultOptions", ",", "manyPlotOptions"}], "]"}]}], 
           "]"}]}]}], "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]",
      "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"ClearAll", "[", 
    RowBox[{"p2", ",", " ", "p3", ",", " ", "pall"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"p2", " ", "=", " ", 
     RowBox[{"plotOnePair", "[", 
      RowBox[{
       RowBox[{"data", "[", 
        RowBox[{"[", "2", "]"}], "]"}], ",", " ", "True"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"p3", "  ", "=", " ", 
    RowBox[{"plotOnePair", "[", 
     RowBox[{
      RowBox[{"data", "[", 
       RowBox[{"[", "3", "]"}], "]"}], ",", " ", "True"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pall", " ", "=", " ", 
     RowBox[{"GraphicsGrid", "[", 
      RowBox[{"Partition", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"plotOnePair", "[", 
           RowBox[{"#", ",", " ", "False"}], "]"}], "&"}], "/@", " ", 
         "data"}], ",", 
        RowBox[{"UpTo", "[", "4", "]"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Export", "[", 
    RowBox[{"\"\<p2.jpeg\>\"", ",", " ", "p2"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Export", "[", 
    RowBox[{"\"\<p3.jpeg\>\"", ",", " ", "p3"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Export", "[", 
    RowBox[{"\"\<p_all.jpeg\>\"", ",", " ", "pall"}], "]"}], 
   "\[IndentingNewLine]"}]}]], "Input",
